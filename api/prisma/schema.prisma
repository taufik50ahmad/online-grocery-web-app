generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  CUSTOMER
  STORE_ADMIN
  SUPER_ADMIN
  ADMIN
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  DELIVERED
  SUBMITTED
  CANCELLED
  SHIPPED
  COMPLETED
}

model User {
  id             Int         @id @default(autoincrement())
  email          String      @unique
  password       String
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  isVerified     Boolean     @default(false) @map("is_verified")
  name           String?
  phone          String?
  role           UserRole    @default(CUSTOMER)
  profilePicture String?     @map("profile_picture")
  address        Address[]
  cartItem       CartItem[]
  order          Order[]
  stores         stores[]
  tokens         UserToken[]

  @@map("users")
}

model UserToken {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  token     String        @unique
  type      UserTokenType
  expiredAt DateTime      @map("expired_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_tokens")
}

model Product {
  id         Int         @id @default(autoincrement())
  name       String
  price      Int
  stock      Int
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  cartItem   CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model CartItem {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  productId   Int      @map("product_id")
  productName String   @map("product_name")
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")
  totalPrice  Int      @map("total_price")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("warehouses")
}

model Address {
  id             Int      @id @default(autoincrement())
  address        String
  city           String
  phone          String
  addressDefault Boolean  @default(false) @map("address_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  userId         Int      @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  totalQuantity Int         @map("total_quantity")
  orderStatus   OrderStatus @default(PENDING) @map("order_status")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  productId   Int      @map("product_id")
  productName String   @map("product_name")
  quantity    Int
  totalPrice  Int      @map("total_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model stores {
  id             Int      @id @default(autoincrement())
  name           String
  address        String?
  city           String?
  latitude       Decimal  @db.Decimal(10, 7)
  longitude      Decimal  @db.Decimal(10, 7)
  store_admin_id Int?
  created_at     DateTime @default(now())
  updated_at     DateTime
  users          User?    @relation(fields: [store_admin_id], references: [id])
}
