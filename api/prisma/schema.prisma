generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  DELIVERED
  CANCELLED
  SHIPPED
  COMPLETED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model CartItem {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  productId   Int      @map("product_id")
  productName String   @map("product_name")
  quantity    Int
  totalPrice  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cart_items")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

model Address {
  id             Int      @id @default(autoincrement())
  userId         Int
  address        String
  city           String
  phone          String
  addressDefault Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("addresses")
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  productId   Int
  productName String
  quantity    Int
  totalPrice  Int
  orderStatus OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
