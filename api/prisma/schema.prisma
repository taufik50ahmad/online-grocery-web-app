// api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum UserRole {
  USER
  CUSTOMER
  STORE_ADMIN
  SUPER_ADMIN
  ADMIN
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  DELIVERED
  CANCELLED
  SHIPPED
  COMPLETED
}

model User {
  id             Int         @id @default(autoincrement())
  email          String      @unique
  password       String
  name           String?
  phone          String?
  isVerified     Boolean     @default(false) @map("is_verified")
  profilePicture String?     @map("profile_picture")
  role           UserRole    @default(CUSTOMER)
  storeId        Int?        @map("store_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  cartItem       CartItem[]
  address        Address[]
  order          Order[]
  tokens         UserToken[]
  store          Store?      @relation(fields: [storeId], references: [id], onDelete: SetNull)
  stockJournals  StockJournal[]
  discounts      Discount[]

  @@map("users")
}

model UserToken {
  id        Int           @id @default(autoincrement())
  userId    Int           @map("user_id")
  token     String        @unique
  type      UserTokenType
  expiredAt DateTime      @map("expired_at")
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_tokens")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  imageUrl  String?   @map("image_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String?
  price       Int
  stock       Int            @default(0)
  unit        String         @default("pcs")
  isActive    Boolean        @default(true) @map("is_active")
  categoryId  Int?           @map("category_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  cartItem    CartItem[]
  order       Order[]
  stocks      Stock[]
  journals    StockJournal[]
  discounts   Discount[]

  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model CartItem {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  productId   Int      @map("product_id")
  productName String   @map("product_name")
  quantity    Int
  totalPrice  Int      @map("total_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("warehouses")
}

model Address {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  address        String
  city           String
  phone          String
  addressDefault Boolean  @default(false) @map("address_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int         @map("user_id")
  productId   Int         @map("product_id")
  productName String      @map("product_name")
  quantity    Int
  totalPrice  Int         @map("total_price")
  orderStatus OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model Store {
  id          Int            @id @default(autoincrement())
  name        String
  address     String?
  city        String?
  latitude    Decimal        @db.Decimal(10, 7)
  longitude   Decimal        @db.Decimal(10, 7)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  users       User[]
  stocks      Stock[]
  journals    StockJournal[]
  discounts   Discount[]

  @@map("stores")
}

model Stock {
  id        Int           @id @default(autoincrement())
  productId Int           @map("product_id")
  storeId   Int           @map("store_id")
  quantity  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  journals  StockJournal[]

  @@unique([productId, storeId])
  @@map("stocks")
}

enum StockJournalType {
  IN
  OUT
  ADJUSTMENT
}

model StockJournal {
  id        Int            @id @default(autoincrement())
  stockId   Int            @map("stock_id")
  productId Int            @map("product_id")
  storeId   Int            @map("store_id")
  type      StockJournalType
  quantity  Int
  note      String?
  userId    Int?           @map("user_id")
  createdAt DateTime       @default(now()) @map("created_at")
  stock     Stock          @relation(fields: [stockId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("stock_journals")
}

enum DiscountType {
  PERCENTAGE
  NOMINAL
  BOGO
}

enum DiscountScope {
  PRODUCT
  TRANSACTION
  SHIPPING
}

model Discount {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  type          DiscountType
  scope         DiscountScope
  value         Int
  minValue      Int?         @map("min_value")
  maxValue      Int?         @map("max_value")
  productId     Int?         @map("product_id")
  storeId       Int          @map("store_id")
  isActive      Boolean      @default(true) @map("is_active")
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById   Int?         @map("created_by_id")

  @@map("discounts")
}
